# Local tooling shims and build logs
.tools/

# Large binaries are never committed (downloaded / built instead)
*.voicepack
*.onnx
dist/
mobile/android/app/libs/*.aar
mobile/android/app/libs/*.part
mobile/android/lame/.cxx/
mobile/android/lame/build/

# Voice training outputs (large, personal)
tools/voice-training/cache/
tools/voice-training/runs/
tools/voice-training/work/
tools/voice-training/dist/
*.ckpt
*.voicedataset.zip
__pycache__/

# Release signing (never commit)
keystore.properties

# Built-in voice packs (~31 MB each): rebuild with docs/voice-packages.md
mobile/android/app/src/main/assets/voices/*.voicepack
